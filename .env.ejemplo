# ============================================
# PLANTILLA DE CONFIGURACION
# ============================================
# Copiar este archivo como .env y completar los valores.
# El .env real NO se sube al repositorio (esta en .gitignore).

# Que motor usa el clasificador: "nvidia" o "ollama"
PROVEEDOR=nvidia

# ---- NVIDIA (build.nvidia.com) ----
# La clave se saca en la ficha de cualquier modelo,
# boton "Get API Key". Empieza con nvapi-
NVIDIA_API_KEY=

# ID exacto del modelo, copiado del ejemplo de codigo
# que aparece en la ficha del modelo.
MODELO_NVIDIA=nvidia/nemotron-3-super-120b-a12b

# ---- OLLAMA (local, respaldo) ----
MODELO_OLLAMA=llama3.2:3b
OLLAMA_HOST=http://localhost:11434